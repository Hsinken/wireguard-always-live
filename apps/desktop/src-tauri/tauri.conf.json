{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WG Always Live",
  "identifier": "io.github.hsinken.wg-always-live",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WG Always Live",
        "width": 720,
        "height": 480,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
